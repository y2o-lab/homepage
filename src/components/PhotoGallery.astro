---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/lib/content';

interface Props {
  photos: CollectionEntry<'photos'>[];
}

const { photos } = Astro.props;
const [latestPhoto, ...pastPhotos] = photos;
---

{
  latestPhoto && (
    <section class="photo-gallery" aria-label="写真一覧" data-photo-gallery>
      <div class="photo-gallery__layout">
        <article class="photo-card photo-card--latest">
          <a
            class="photo-card__link"
            data-photo-lightbox-link
            href={latestPhoto.data.image}
            data-pswp-width={latestPhoto.data.imageWidth}
            data-pswp-height={latestPhoto.data.imageHeight}
            data-cropped="true"
            target="_blank"
            aria-label={`${formatDate(latestPhoto.data.takenDate)}、${latestPhoto.data.title}を大きく表示`}
          >
            <img
              src={latestPhoto.data.image}
              alt={latestPhoto.data.imageAlt}
              width={latestPhoto.data.imageWidth}
              height={latestPhoto.data.imageHeight}
              loading="eager"
            />
            <span class="photo-card__overlay">
              <time datetime={latestPhoto.data.takenDate.toISOString()}>
                {formatDate(latestPhoto.data.takenDate)}
              </time>
              <strong>{latestPhoto.data.title}</strong>
              <span>{latestPhoto.data.description}</span>
            </span>
          </a>
        </article>

        {
          pastPhotos.length > 0 && (
            <div class="photo-gallery__past" aria-label="過去の写真">
              {pastPhotos.map((photo) => (
                <article class="photo-card photo-card--compact">
                  <a
                    class="photo-card__link"
                    data-photo-lightbox-link
                    href={photo.data.image}
                    data-pswp-width={photo.data.imageWidth}
                    data-pswp-height={photo.data.imageHeight}
                    data-cropped="true"
                    target="_blank"
                    aria-label={`${formatDate(photo.data.takenDate)}、${photo.data.title}を大きく表示`}
                  >
                    <img
                      src={photo.data.image}
                      alt={photo.data.imageAlt}
                      width={photo.data.imageWidth}
                      height={photo.data.imageHeight}
                      loading="lazy"
                    />
                    <span class="photo-card__overlay">
                      <time datetime={photo.data.takenDate.toISOString()}>
                        {formatDate(photo.data.takenDate)}
                      </time>
                      <strong>{photo.data.title}</strong>
                      <span>{photo.data.description}</span>
                    </span>
                  </a>
                </article>
              ))}
            </div>
          )
        }
      </div>
    </section>
  )
}

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const gallery = document.querySelector<HTMLElement>('[data-photo-gallery]');

  if (gallery) {
    const lightbox = new PhotoSwipeLightbox({
      gallery,
      children: '[data-photo-lightbox-link]',
      pswpModule: () => import('photoswipe'),
      showHideAnimationType: 'none',
    });

    lightbox.init();
  }
</script>

<style>
  .photo-gallery__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(18rem, 0.54fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: start;
  }

  .photo-card {
    min-width: 0;
  }

  .photo-card__link {
    position: relative;
    display: block;
    min-height: 11rem;
    overflow: hidden;
    background: #dcd5c8;
    border: 1px solid rgb(43 47 45 / 0.14);
    border-radius: 8px;
    box-shadow: 0 18px 44px rgb(41 35 25 / 0.12);
    color: #ffffff;
    text-decoration: none;
  }

  .photo-card__link img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .photo-card__link:hover img,
  .photo-card__link:focus-visible img {
    transform: scale(1.025);
  }

  .photo-card__overlay {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.3rem;
    padding: 0.85rem;
    background: linear-gradient(180deg, rgb(13 16 17 / 0), rgb(13 16 17 / 0.8));
  }

  .photo-card__overlay time {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }

  .photo-card__overlay strong {
    font-size: 0.96rem;
    line-height: 1.25;
  }

  .photo-card__overlay span {
    color: rgb(255 255 255 / 0.84);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .photo-card--latest .photo-card__link {
    min-height: clamp(24rem, 46vw, 36rem);
  }

  .photo-card--latest .photo-card__overlay {
    gap: 0.45rem;
    padding: clamp(1rem, 2.8vw, 1.25rem);
  }

  .photo-card--latest .photo-card__overlay time {
    font-size: 0.9rem;
  }

  .photo-card--latest .photo-card__overlay strong {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
  }

  .photo-card--latest .photo-card__overlay span {
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .photo-gallery__past {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .photo-card--compact .photo-card__overlay span {
    display: none;
  }

  @media (max-width: 820px) {
    .photo-gallery__layout {
      grid-template-columns: 1fr;
    }

    .photo-gallery__past {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    }
  }
</style>
