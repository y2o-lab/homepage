---
import { getCollection } from 'astro:content';
import BookShelf from '@/components/BookShelf.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byNewest, isPublished, sectionDescriptions, sectionLabels } from '@/lib/content';

const section = 'books';
const entries = (await getCollection(section)).filter(isPublished).sort(byNewest);
---

<BaseLayout
  title={sectionLabels[section]}
  description={sectionDescriptions[section]}
>
  <section class="section-header">
    <p class="eyebrow" lang="en">Reading</p>
    <h1 lang="en">{sectionLabels[section]}</h1>
    <p class="lead">{sectionDescriptions[section]}</p>
  </section>
  <BookShelf entries={entries} />
</BaseLayout>
