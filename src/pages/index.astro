---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  byNewest,
  type ContentSection,
  formatDate,
  isPublished,
  sectionDescriptions,
  sectionLabels,
} from '@/lib/content';
import { site } from '@/site.config';

const sections: ContentSection[] = ['blog', 'projects', 'notes', 'books'];
const sectionEntries = await Promise.all(
  sections.map(async (section) => {
    const entries = (await getCollection(section)).filter(isPublished).sort(byNewest);

    return {
      section,
      entries,
      latestEntry: entries[0],
    };
  }),
);
const latestEntries = sectionEntries
  .flatMap(({ entries, section }) => entries.slice(0, 2).map((entry) => ({ entry, section })))
  .sort((a, b) => byNewest(a.entry, b.entry))
  .slice(0, 3);
---

<BaseLayout>
  <section class="desk-board" data-testid="home-dashboard" aria-labelledby="home-title">
    <aside class="sidebar" aria-label="プロフィール概要">
      <div class="avatar-frame">
        <img src="/dashboard-avatar.webp" alt={`${site.author} のプロフィールアイコン`} width="512" height="512" />
      </div>
      <p class="kicker">Personal site</p>
      <h1 class="hero-title" id="home-title">Build notes for the web.</h1>
      <p class="hero-copy">
        作ったもの、使っている技術、最近の関心を一覧しやすくまとめるポートフォリオ寄りのホームです。
        制作ログや学びのメモへ、ここからすぐ移動できます。
      </p>
      <div class="sidebar-actions" aria-label="主要リンク">
        <a class="button" href="/projects/">View Works</a>
        <a class="button secondary" href="/blog/">Read Blog</a>
      </div>
    </aside>

    <div class="panel-area">
      <div class="toolbar">
        <div class="chip-row" aria-label="現在の活動">
          <span class="chip">Available</span>
          <span class="chip">Astro</span>
          <span class="chip">TypeScript</span>
        </div>
        <a class="button" href="/projects/">作ったものを見る</a>
      </div>

      <section class="latest-panel" aria-labelledby="latest-title">
        <div class="panel-heading">
          <p class="kicker">Latest</p>
          <h2 id="latest-title">最近の更新</h2>
        </div>
        <div class="latest-list" aria-label="最近の更新">
          {
            latestEntries.length > 0 ? (
              latestEntries.map(({ entry, section }) => (
                <a href={`/${section}/${entry.id}/`}>
                  <span>{sectionLabels[section]}</span>
                  <strong>{entry.data.title}</strong>
                  <time datetime={entry.data.pubDate.toISOString()}>
                    {formatDate(entry.data.pubDate)}
                  </time>
                </a>
              ))
            ) : (
              <p class="empty-dashboard">coming soon...</p>
            )
          }
        </div>
      </section>

      <section class="index-panel" aria-labelledby="sections-title">
        <div class="panel-heading">
          <p class="kicker">Index</p>
          <h2 id="sections-title">見るもの</h2>
        </div>
        <div class="project-grid">
          {
            sectionEntries.map(({ section, entries, latestEntry }) => (
              <a class="project-card" href={`/${section}/`}>
                <div>
                  <h3>{sectionLabels[section]}</h3>
                  <p>{sectionDescriptions[section]}</p>
                </div>
                <div class="project-meta">
                  <span>{entries.length}件</span>
                  {latestEntry && <span>最新 {formatDate(latestEntry.data.pubDate)}</span>}
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background:
      linear-gradient(90deg, rgb(255 247 226 / 0.92), rgb(238 221 184 / 0.84)),
      #efddb8;
    color: #2e261d;
  }

  :global(.site-header) {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    padding: 20px 0 18px;
  }

  :global(.site-header .brand) {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    color: #2e261d;
    font-weight: 900;
    letter-spacing: 0;
    text-decoration: none;
  }

  :global(.site-header .brand::before) {
    display: block;
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border: 2px solid rgb(46 38 29 / 0.8);
    border-radius: 50%;
    background:
      image-set(url("/dashboard-avatar.webp") type("image/webp")) center / cover,
      #f7e3b8;
    content: "";
  }

  :global(.site-header nav) {
    gap: 0.55rem 1.25rem;
    color: rgb(46 38 29 / 0.76);
    font-size: 0.9rem;
    font-weight: 800;
  }

  :global(.site-header nav a) {
    white-space: nowrap;
  }

  :global(main) {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    padding: 0 0 42px;
  }

  :global(footer) {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    border-top-color: rgb(77 51 36 / 0.18);
    color: rgb(46 38 29 / 0.58);
  }

  .desk-board {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 28px;
    min-height: calc(100svh - 74px);
  }

  .sidebar {
    min-width: 0;
    border-right: 1px solid rgb(76 51 36 / 0.2);
    padding: 26px 28px 26px 0;
  }

  .avatar-frame {
    position: relative;
    isolation: isolate;
    width: min(220px, 100%);
    margin-bottom: 28px;
  }

  .avatar-frame::before {
    position: absolute;
    z-index: -1;
    inset: 8% -6% -6% 10%;
    border: 2px solid rgb(77 51 36 / 0.18);
    border-radius: 28px;
    content: "";
    transform: rotate(3deg);
  }

  .avatar-frame img {
    width: 100%;
    aspect-ratio: 1;
    border: 2px solid rgb(46 38 29 / 0.78);
    border-radius: 22px;
    box-shadow: 0 24px 70px rgb(77 51 36 / 0.18);
    object-fit: cover;
  }

  .kicker {
    margin: 0 0 14px;
    color: #b66d43;
    font-size: 0.8rem;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 100%;
    margin: 0 0 18px;
    color: #2e261d;
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 6.5vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  .hero-copy {
    margin: 0 0 22px;
    color: rgb(46 38 29 / 0.72);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .sidebar-actions,
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .button,
  .chip,
  .project-meta span,
  .latest-list span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(77 51 36 / 0.18);
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
  }

  .button {
    min-height: 44px;
    padding: 0 18px;
    background: #2e261d;
    color: #fff6dd;
    font-size: 0.88rem;
    font-weight: 900;
    box-shadow: 0 10px 24px rgb(46 38 29 / 0.18);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .button.secondary {
    background: rgb(255 246 221 / 0.58);
    color: #4d3324;
    box-shadow: none;
  }

  .button:hover {
    color: #fff6dd;
    transform: translateY(-2px);
  }

  .button.secondary:hover {
    border-color: rgb(77 51 36 / 0.34);
    background: #fff8e8;
    color: #4d3324;
  }

  .chip {
    min-height: 34px;
    padding: 0 12px;
    background: rgb(255 250 235 / 0.58);
    color: #4d3324;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .panel-area {
    display: grid;
    grid-template-rows: auto auto 1fr;
    min-width: 0;
    gap: 22px;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid rgb(76 51 36 / 0.2);
    padding: 26px 0 18px;
  }

  .panel-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 12px;
  }

  .panel-heading h2 {
    margin: 0;
    color: #2e261d;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .latest-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .latest-list a,
  .project-card {
    min-width: 0;
    border: 1px solid rgb(77 51 36 / 0.18);
    border-radius: 8px;
    background: rgb(255 248 228 / 0.74);
    box-shadow: 0 18px 44px rgb(77 51 36 / 0.08);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .latest-list a {
    display: grid;
    gap: 7px;
    min-height: 120px;
    align-content: start;
    padding: 16px;
  }

  .latest-list a:nth-child(2),
  .project-card:nth-child(2) {
    background: rgb(234 223 196 / 0.82);
  }

  .latest-list a:nth-child(3),
  .project-card:nth-child(3) {
    background: rgb(226 232 205 / 0.72);
  }

  .latest-list a:hover,
  .project-card:hover {
    border-color: rgb(77 51 36 / 0.34);
    background: #fff8e8;
    color: inherit;
    transform: translateY(-2px);
  }

  .latest-list span {
    width: fit-content;
    max-width: 100%;
    padding: 0.12rem 0.5rem;
    background: rgb(226 232 205 / 0.76);
    color: #4c654e;
    font-size: 0.72rem;
    font-weight: 950;
  }

  .latest-list strong {
    color: #2e261d;
    font-size: 1rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .latest-list time {
    margin-top: auto;
    color: rgb(46 38 29 / 0.64);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .project-card {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    padding: 20px;
  }

  .project-card h3 {
    margin: 0 0 10px;
    color: #2e261d;
    font-size: clamp(1.15rem, 2vw, 1.38rem);
    line-height: 1.18;
    overflow-wrap: anywhere;
  }

  .project-card p {
    margin: 0;
    color: rgb(46 38 29 / 0.68);
    font-weight: 650;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .project-meta span {
    padding: 5px 9px;
    color: #4d3324;
    font-size: 0.7rem;
    font-weight: 900;
  }

  .empty-dashboard {
    margin: 0;
    color: rgb(46 38 29 / 0.64);
  }

  @media (max-width: 1060px) {
    .desk-board {
      grid-template-columns: 260px minmax(0, 1fr);
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 880px) {
    .desk-board {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .sidebar {
      border-right: 0;
      border-bottom: 1px solid rgb(76 51 36 / 0.2);
      padding-right: 0;
    }

    .avatar-frame {
      width: min(180px, 55vw);
    }

    .latest-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    :global(.site-header),
    :global(main),
    :global(footer) {
      width: min(100% - 28px, 1180px);
    }

    :global(.site-header nav) {
      justify-content: flex-start;
      overflow-x: auto;
      width: 100%;
      padding-bottom: 4px;
    }

    .hero-title {
      font-size: clamp(2.75rem, 16vw, 4.25rem);
    }

    .toolbar {
      align-items: stretch;
    }

    .toolbar .button,
    .sidebar-actions .button {
      width: 100%;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card,
    .latest-list a {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .latest-list a,
    .project-card {
      transition: none;
    }

    .button:hover,
    .latest-list a:hover,
    .project-card:hover {
      transform: none;
    }
  }
</style>
